rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net - Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for Attribute-Based Access Control (ABAC)
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Secure all user-owned data sandboxes completely
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // Recursively secure all subcollections (pages, blocks, records, gamification, etc.)
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
